+import { clickMenu } from './keyboard.mjs'
+
+test('installed titlebar actions dispatch commands, preserve tabs and notes, and follow owner cleanup', {
+  timeout: 60000,
+}, async (t) => {
+  const profile = await mkdtemp(join(tmpdir(), 'hibi-titlebar-actions-'))
+  const directory = join(profile, 'installed-addons', 'titlebar-probe')
+  const file = join(profile, 'note.md')
