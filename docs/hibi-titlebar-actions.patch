+  await mkdir(directory, { recursive: true })
+  await writeFile(file, original)
+  await writeFile(
+    join(directory, 'hibi-addon.json'),
+    JSON.stringify({
+      id: 'titlebar-probe',
+      name: 'Titlebar probe',
+      description: 'Titlebar action fixture.',
+      kind: 'extension',
+      apiVersion: 2,
+      version: '1.0.0',
+      capabilities: ['ui'],
+      authors: [{ displayName: 'Test' }],
+      entry: 'index.js',
+    }),
+  )
+  await writeFile(
+    join(directory, '.hibi-install.json'),
+    JSON.stringify({
+      hash: 'a'.repeat(64),
+      files: ['hibi-addon.json', 'index.js'],
+      source: 'local',
+    }),
+  )
+  await writeFile(
+    join(profile, 'addons.json'),
+    JSON.stringify({ 'titlebar-probe': true }),
+  )
+  await writeFile(
+    join(directory, 'index.js'),
+    `export default ({ React }) => ({ start(context) {
+      const h = React.createElement;
+      const runs = [];
+      const tab = context.views.register({
+        id: 'session', label: 'Fixture session', location: 'tab', lifetime: 'session',
+        Content() {
+          const [count, setCount] = React.useState(0);
+          return h('button', { onClick: () => setCount(count + 1) }, 'Count ' + count);
+        },
+      });
+      context.commands.register({
+        id: 'open', label: 'Open fixture session',
+        run(invocation) { runs.push(invocation); tab.open({ id: 'same', focus: true }); },
+      });
+      const register = (id, changes = {}) => context.toolbar.register({
+        id, label: id, location: 'titlebar', commandId: 'open', ...changes,
+      });
+      const handles = {
+        open: register('open', { label: 'Open fixture session', pressed: true }),
+        menu: register('menu', { label: 'Menu session', pressed: true }),
+        normal: register('normal', { when: 'normal' }),
+        source: register('source', { when: 'source' }),
+        disabled: register('disabled', { disabled: true }),
+        hidden: register('hidden', { hidden: true }),
+        savedHidden: register('saved-hidden'),
+        legacy: context.toolbar.register({ id: 'legacy', label: 'Editor action', onClick() {} }),
+      };
+      window.titlebarProbe = { context, handles, runs };
+    } });`,
+  )
+  const app = await electron.launch({
+    args: [resolve('.'), `--user-data-dir=${profile}`],
+  })
+  t.after(async () => {
+    await app.evaluate(({ dialog }) => {
+      dialog.showMessageBox = async () => ({ response: 1 })
+    })
+    await app.close()
+    await rm(profile, { recursive: true, force: true })
+  })
+  const page = await app.firstWindow()
+  page.setDefaultTimeout(7000)
+  await page.setViewportSize({ width: 1200, height: 800 })
+  await page.waitForFunction(() => window.titlebarProbe)
+  await page.evaluate(() =>
+    window.titlebarProbe.context.toolbar.setPreferences({
+      visible: true,
+      placements: {
+        'titlebar-probe.menu': 'menu',
+        'titlebar-probe.saved-hidden': 'hidden',
+        'future.action': 'menu',
+      },
+    }),
+  )
+  await app.evaluate(({ dialog }, path) => {
+    dialog.showOpenDialog = async () => ({ canceled: false, filePaths: [path] })
+  }, file)
+  await clickMenu(app, 'Open…')
+  await waitForDocumentEditor(app, page)
+  const note = await page.evaluate(() => window.hibi.getDocument())
+  const viewTarget = await page.evaluate(() =>
+    window.titlebarProbe.context.editorViews.getActive(),
+  )
+  const action = page.locator(
+    '.titlebar-actions > [data-toolbar-id="titlebar-probe.open"]',
+  )
+  const editorAction = page.locator(
+    '.editor-toolbar > [data-toolbar-id="titlebar-probe.legacy"]',
+  )
+  await action.waitFor()
+  await editorAction.waitFor()
+  assert.equal(await action.getAttribute('aria-pressed'), 'true')
+  assert.equal(
+    await action.evaluate((button) => {
+      const group = button.parentElement
+      const view = document.querySelector('.view-switch')
+      return (
+        group.nextElementSibling === view &&
+        button.getBoundingClientRect().right <=
+          view.getBoundingClientRect().left
+      )
+    }),
+    true,
+  )
+  assert.equal(await action.locator('svg').getAttribute('width'), '16')
+  assert.equal(await action.locator('svg').getAttribute('stroke-width'), '1.5')
+  assert.equal(
+    await page
+      .locator('.editor-toolbar [data-toolbar-id^="titlebar-probe."]')
+      .count(),
+    1,
+  )
+  assert.equal(
+    await page.locator('[data-toolbar-id="titlebar-probe.source"]').count(),
+    0,
+  )
+  assert.equal(
+    await page.locator('[data-toolbar-id="titlebar-probe.hidden"]').count(),
+    0,
+  )
+  assert.equal(
+    await page
+      .locator('[data-toolbar-id="titlebar-probe.saved-hidden"]')
+      .count(),
+    0,
+  )
+  assert.equal(
+    await page
+      .locator('[data-toolbar-id="titlebar-probe.disabled"]')
+      .isDisabled(),
+    true,
+  )
+
+  await clickMenu(app, 'Command palette')
+  const palette = page.getByRole('dialog', { name: /^command palette$/i })
+  const search = palette.getByRole('combobox', { name: /search commands/i })
+  await search.fill('Open fixture session')
+  const command = palette.getByRole('option', { name: /^Open fixture session/ })
+  await command.waitFor()
+  assert.equal(await command.count(), 1)
+  assert.equal(await command.getAttribute('id'), 'command-titlebar-probe.open')
+  assert.equal(
+    await palette.locator('[id="command-toolbar.titlebar-probe.open"]').count(),
+    0,
+  )
+  await search.fill('Editor action')
+  const editorCommand = palette.getByRole('option', { name: /^Editor action/ })
+  await editorCommand.waitFor()
+  assert.equal(
+    await editorCommand.getAttribute('id'),
+    'command-toolbar.titlebar-probe.legacy',
+  )
+  await page.keyboard.press('Escape')
+  await palette.waitFor({ state: 'hidden' })
+
+  await page.setViewportSize({ width: 480, height: 800 })
+  await page
+    .getByRole('button', { name: 'More formatting actions', exact: true })
+    .waitFor()
+  assert.equal(await action.isVisible(), true)
+  await page.evaluate(() =>
+    window.titlebarProbe.context.toolbar.setPreferences({
+      visible: false,
+      mode: 'text',
+    }),
+  )
+  await page.locator('.editor-toolbar').waitFor({ state: 'detached' })
+  assert.equal(await action.isVisible(), true)
+  await action.click()
+  const tab = page.getByRole('tab', { name: 'Fixture session', exact: true })
+  const panel = page.getByRole('tabpanel', {
+    name: 'Fixture session',
+    exact: true,
+  })
+  await panel.getByRole('button', { name: 'Count 0' }).click()
+  await page.locator(`#document-tab-${note.tabId}`).click()
+  await action.click()
+  await panel.getByRole('button', { name: 'Count 1' }).waitFor()
+  assert.equal(await tab.count(), 1)
+  assert.equal(await tab.getAttribute('aria-selected'), 'true')
+  assert.deepEqual(
+    await page.evaluate(() =>
+      window.titlebarProbe.runs.map((run) => run.source),
+    ),
+    ['toolbar', 'toolbar'],
+  )
+  assert.equal(
+    await page.evaluate(() => window.titlebarProbe.runs[0].document.documentId),
+    viewTarget.documentId,
+  )
+
+  await page
+    .getByRole('button', { name: 'More titlebar actions', exact: true })
+    .click()
+  const menuAction = page.getByRole('menuitemcheckbox', {
+    name: 'Menu session',
+    exact: true,
+  })
+  assert.equal(await menuAction.getAttribute('aria-checked'), 'true')
+  await menuAction.press('Enter')
+  assert.equal(await tab.count(), 1)
+  await page.locator(`#document-tab-${note.tabId}`).click()
+  await page.getByRole('button', { name: 'Source view', exact: true }).click()
+  await page.locator('[data-toolbar-id="titlebar-probe.source"]').waitFor()
+  assert.equal(
+    await page.locator('[data-toolbar-id="titlebar-probe.normal"]').count(),
+    0,
+  )
+  await page.evaluate(() =>
+    window.titlebarProbe.handles.open.update({ hidden: true }),
+  )
+  await action.waitFor({ state: 'detached' })
+  await page.evaluate(() =>
+    window.titlebarProbe.handles.open.update({
+      hidden: false,
+      disabled: true,
+      pressed: false,
+    }),
+  )
+  await action.waitFor()
+  assert.equal(await action.isDisabled(), true)
+  assert.equal(await action.getAttribute('aria-pressed'), 'false')
+
+  await page.setViewportSize({ width: 1200, height: 800 })
+  await clickMenu(app, 'Settings')
+  await page.getByRole('tab', { name: 'Addon Manager', exact: true }).click()
+  await page.locator('#addon-titlebar-probe').click()
+  await page.getByRole('button', { name: 'Back to app', exact: true }).click()
+  await page
+    .locator('[data-toolbar-id^="titlebar-probe."]')
+    .waitFor({ state: 'detached' })
+  assert.equal(await tab.count(), 0)
+  await page.evaluate(() =>
