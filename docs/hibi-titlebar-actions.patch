+import { Ellipsis, Puzzle } from 'lucide-react'
+import {
+  useId,
+  useLayoutEffect,
+  useRef,
+  useState,
+  useSyncExternalStore,
+} from 'react'
+import { Button, IconButton } from '../../ui/Controls'
+import type { ViewMode } from './Editor'
+import { toolbar, visibleToolbarItems } from './toolbar'
+import './toolbar.css'
+
+export function TitlebarActions({ mode }: { mode: ViewMode }) {
+  const snapshot = useSyncExternalStore(toolbar.subscribe, toolbar.snapshot)
+  const visible = visibleToolbarItems(snapshot, 'titlebar', mode)
+  const inline = visible.filter(
+    (item) => snapshot.preferences.placements?.[item.id] !== 'menu',
+  )
+  const menuItems = visible.filter(
+    (item) => snapshot.preferences.placements?.[item.id] === 'menu',
+  )
+  const menuId = useId()
+  const more = useRef<HTMLButtonElement>(null)
+  const menu = useRef<HTMLDivElement>(null)
+  const [open, setOpen] = useState(false)
+  const closeMenu = () => {
+    menu.current?.hidePopover()
+    setOpen(false)
+  }
+  useLayoutEffect(() => {
+    if (!open) return
+    if (!menuItems.length) {
+      menu.current?.hidePopover()
+      setOpen(false)
+      return
+    }
+    const popup = menu.current,
+      button = more.current
+    if (!popup || !button) return
+    const rect = button.getBoundingClientRect()
+    popup.style.top = `${rect.bottom + 4}px`
+    popup.style.left = `${Math.max(8, Math.min(innerWidth - popup.offsetWidth - 8, rect.right - popup.offsetWidth))}px`
+    popup.style.maxHeight = `${Math.max(80, innerHeight - rect.bottom - 12)}px`
+    popup.querySelector<HTMLButtonElement>('button:not(:disabled)')?.focus()
+  }, [open, menuItems.length])
+  if (!visible.length) return null
+  return (
+    <nav className="titlebar-actions" aria-label="Addon titlebar actions">
+      {inline.map((item) => {
+        const Icon = item.icon ?? Puzzle
+        return (
+          <IconButton
+            key={item.id}
+            data-toolbar-id={item.id}
+            aria-label={item.label}
+            aria-pressed={item.pressed}
+            disabled={item.disabled}
+            title={item.tooltip ?? item.label}
+            onClick={() => void item.onClick()}
+          >
+            <Icon size={16} strokeWidth={1.5} aria-hidden />
+          </IconButton>
+        )
+      })}
+      {!!menuItems.length && (
+        <>
+          <IconButton
+            ref={more}
+            aria-label="More titlebar actions"
+            aria-haspopup="menu"
+            aria-expanded={open}
+            aria-controls={menuId}
+            onClick={() => menu.current?.togglePopover()}
+          >
+            <Ellipsis size={16} strokeWidth={1.5} aria-hidden />
+          </IconButton>
+          <div
+            ref={menu}
+            id={menuId}
+            popover="auto"
+            role="menu"
+            aria-hidden={!open}
+            inert={!open}
+            aria-label="More titlebar actions"
+            className="toolbar-menu"
+            onToggle={(event) => setOpen(event.newState === 'open')}
+            onKeyDown={(event) => {
+              if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+                event.preventDefault()
+                const buttons = Array.from(
+                  event.currentTarget.querySelectorAll<HTMLButtonElement>(
+                    'button:not(:disabled)',
+                  ),
+                )
+                const current = buttons.indexOf(
+                  document.activeElement as HTMLButtonElement,
+                )
+                const index =
+                  event.key === 'Home'
+                    ? 0
+                    : event.key === 'End'
+                      ? buttons.length - 1
+                      : (current +
+                          (event.key === 'ArrowDown'
+                            ? 1
+                            : buttons.length - 1)) %
+                        buttons.length
+                buttons[index]?.focus()
+              } else if (event.key === 'Escape' || event.key === 'Tab') {
+                if (event.key === 'Escape') event.preventDefault()
+                closeMenu()
+                more.current?.focus()
+              }
+            }}
+          >
+            {menuItems.map((item) => {
+              const Icon = item.icon ?? Puzzle
+              return (
+                <Button
+                  key={item.id}
+                  data-toolbar-id={item.id}
+                  role={
+                    item.pressed === undefined ? 'menuitem' : 'menuitemcheckbox'
+                  }
+                  aria-checked={item.pressed}
+                  disabled={item.disabled}
+                  onClick={() => {
+                    closeMenu()
+                    void item.onClick()
+                  }}
+                >
+                  <Icon size={16} strokeWidth={1.5} aria-hidden />
+                  <span>{item.label}</span>
+                </Button>
+              )
+            })}
+          </div>
+        </>
+      )}
+    </nav>
+  )
+}
